# Copy to .env and fill in. All variables use the LMS_ prefix.
LMS_ENVIRONMENT=development
# One switch for the whole setup: development | single | scalable (docs/deployment.md)
#   development: jobs run inline, files in a local folder   (your machine; also deployable as one container)
#   single:      BullMQ on one Redis server, local files     (one server, deploy/compose.single.yml)
#   scalable:    SQS + dead-letter queues, S3 files          (AWS ECS on EC2, deploy/aws)
LMS_DEPLOY_PROFILE=development
# Neon: paste the connection string as-is (sslmode/channel_binding are handled).
LMS_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
LMS_JWT_SECRET=replace-with-64-random-characters-generated-by-openssl-rand-hex-32
LMS_CORS_ORIGINS=http://localhost:5173
LMS_SEED_DEMO_DATA=true
LMS_SCHEDULER_ENABLED=false
# AI service: "rules" (offline, deterministic) or "groq"
LMS_AI_PROVIDER=rules
LMS_GROQ_API_KEY=
LMS_GROQ_MODEL=openai/gpt-oss-120b
# Redis + BullMQ queue. Upstash TCP URL: rediss://default:<token>@<host>:6379
LMS_REDIS_URL=
# Leave empty to follow LMS_DEPLOY_PROFILE; or force inline | bullmq | sqs
LMS_QUEUE_BACKEND=
LMS_UPSTASH_REDIS_REST_URL=
LMS_UPSTASH_REDIS_REST_TOKEN=
# API call log (one line per request; calls slower than this are warnings)
LMS_LOG_REQUESTS=true
LMS_SLOW_REQUEST_MS=1000

# Load and retries (defaults are fine for a few thousand people)
LMS_WORKER_CONCURRENCY=8
LMS_JOB_ATTEMPTS=5
LMS_NOTIFICATION_RATE_PER_SECOND=50
# Full links in emails / WhatsApp messages point here.
LMS_PUBLIC_APP_URL=http://localhost:5173

# ---- scalable profile (AWS) - also usable locally with deploy/compose.aws-local.yml ----
# LMS_AWS_REGION=ap-southeast-1
# LMS_SQS_ENDPOINT_URL=http://localhost:9324     # ElasticMQ locally; empty in AWS
# LMS_SQS_QUEUE_PREFIX=lms-
# LMS_S3_BUCKET=lms-files
# LMS_S3_ENDPOINT_URL=http://localhost:9000      # MinIO locally; empty in AWS
# LMS_SCHEDULER_SOURCE=worker                    # "external" when EventBridge sends the tick
# AWS_ACCESS_KEY_ID=local                        # only for ElasticMQ/MinIO; ECS uses the task role
# AWS_SECRET_ACCESS_KEY=localsecret
