# Copy to .env and fill in. All variables use the LMS_ prefix.
LMS_ENVIRONMENT=development
# Neon: paste the connection string as-is (sslmode/channel_binding are handled).
LMS_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
LMS_JWT_SECRET=replace-with-64-random-characters-generated-by-openssl-rand-hex-32
LMS_CORS_ORIGINS=http://localhost:5173
LMS_SEED_DEMO_DATA=true
LMS_SCHEDULER_ENABLED=false
# AI service: "rules" (offline, deterministic) or "groq"
LMS_AI_PROVIDER=rules
LMS_GROQ_API_KEY=
LMS_GROQ_MODEL=openai/gpt-oss-120b
# Redis + BullMQ queue. Upstash TCP URL: rediss://default:<token>@<host>:6379
LMS_REDIS_URL=
# "inline" runs jobs in-process (tests/offline); "bullmq" sends them to the worker
LMS_QUEUE_BACKEND=inline
LMS_UPSTASH_REDIS_REST_URL=
LMS_UPSTASH_REDIS_REST_TOKEN=
